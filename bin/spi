#!/usr/bin/env python3

import json
import os
import platform
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PRODUCTS = ROOT / "products"
STATE = ROOT / "state"


def output(data: dict, exit_code: int = 0) -> None:
    print(json.dumps(data, indent=2))
    raise SystemExit(exit_code)


def load_product(product_id: str) -> dict:
    path = PRODUCTS / product_id / "product.json"

    if not path.exists():
        output(
            {
                "success": False,
                "error": f"Unknown product: {product_id}",
            },
            1,
        )

    return json.loads(path.read_text())


def command_version() -> None:
    version = (ROOT / "VERSION").read_text().strip()

    output(
        {
            "product": "Seymour Platform Installer",
            "command": "version",
            "version": version,
        }
    )


def command_platform() -> None:
    sys.path.insert(0, str(ROOT / "lib"))

    from spi_platform import detect_platform

    output(detect_platform())


def command_products() -> None:
    products = []

    for manifest in sorted(PRODUCTS.glob("*/product.json")):
        data = json.loads(manifest.read_text())
        product = data["product"]

        products.append(
            {
                "id": product["id"],
                "name": product["name"],
                "version": product["version"],
                "status": product.get("status", "unknown"),
            }
        )

    output(
        {
            "success": True,
            "count": len(products),
            "products": products,
        }
    )


def command_show(product_id: str) -> None:
    output(load_product(product_id))


def command_plan(product_id: str) -> None:
    manifest = load_product(product_id)

    steps = [
        {
            "step": number,
            "key": key,
            "status": "pending",
        }
        for number, key in enumerate(
            manifest["lifecycle"]["install"],
            start=1,
        )
    ]

    output(
        {
            "success": True,
            "mode": "plan",
            "safeMode": True,
            "changesApplied": False,
            "product": manifest["product"],
            "target": {
                "hostname": platform.node(),
                "architecture": platform.machine(),
            },
            "steps": steps,
        }
    )


def command_doctor() -> None:
    checks = [
        {
            "name": "python3",
            "healthy": sys.version_info >= (3, 10),
        },
        {
            "name": "products-directory",
            "healthy": PRODUCTS.is_dir(),
        },
        {
            "name": "state-directory",
            "healthy": STATE.is_dir(),
        },
        {
            "name": "state-writable",
            "healthy": STATE.is_dir() and os.access(STATE, os.W_OK),
        },
    ]

    healthy = all(check["healthy"] for check in checks)

    output(
        {
            "product": "Seymour Platform Installer",
            "ready": healthy,
            "safeMode": True,
            "checks": checks,
        },
        0 if healthy else 1,
    )


def show_help() -> None:
    print(
        """Seymour Platform Installer

Commands:
  spi version
  spi platform
  spi products
  spi product show <product-id>
  spi plan <product-id>
  spi doctor

Package 001 is read-only.
"""
    )


def main() -> None:
    args = sys.argv[1:]
    command = args[0] if args else "help"

    if command == "version":
        command_version()
    elif command == "platform":
        command_platform()
    elif command == "products":
        command_products()
    elif command == "product" and len(args) >= 3 and args[1] == "show":
        command_show(args[2])
    elif command == "plan" and len(args) >= 2:
        command_plan(args[1])
    elif command == "doctor":
        command_doctor()
    elif command in {"help", "--help", "-h"}:
        show_help()
    else:
        output(
            {
                "success": False,
                "error": "Unknown or incomplete command.",
            },
            1,
        )


if __name__ == "__main__":
    main()
