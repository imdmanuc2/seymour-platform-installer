#!/usr/bin/env python3

from __future__ import annotations

import json
import os
import platform
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
PRODUCTS = ROOT / "products"
STATE = ROOT / "state"

sys.path.insert(0, str(ROOT / "lib"))

from lifecycle.executor import LifecycleExecutor
from lifecycle.preflight import validate_lifecycle_plan
from lifecycle.operation import summarize_operation
from plugins.defaults import build_default_registry
from adapters.model import list_adapters, require_adapter
from core.capabilities import ALL_CAPABILITIES
from core.compatibility import validate_product
from core.platform import detect_platform
from state.store import StateStore


def output(data: Any, exit_code: int = 0) -> None:
    print(json.dumps(data, indent=2))
    raise SystemExit(exit_code)


def load_product(product_id: str) -> dict[str, Any]:
    path = PRODUCTS / product_id / "product.json"

    if not path.exists():
        output(
            {
                "success": False,
                "error": f"Unknown product: {product_id}",
            },
            1,
        )

    return json.loads(path.read_text())


def product_steps(
    manifest: dict[str, Any],
    action: str,
) -> list[dict[str, Any]]:
    lifecycle = manifest.get("lifecycle", {})

    if action not in lifecycle:
        output(
            {
                "success": False,
                "error": (
                    f"Product {manifest['product']['id']} "
                    f"does not define lifecycle action: {action}"
                ),
            },
            1,
        )

    return [
        {
            "step": number,
            "key": key,
            "status": "pending",
        }
        for number, key in enumerate(lifecycle[action], start=1)
    ]


def command_version() -> None:
    output(
        {
            "product": "Seymour Platform Installer",
            "command": "version",
            "version": (ROOT / "VERSION").read_text().strip(),
        }
    )


def command_platform() -> None:
    output(detect_platform())


def command_products() -> None:
    products = []

    for manifest_path in sorted(PRODUCTS.glob("*/product.json")):
        manifest = json.loads(manifest_path.read_text())
        product = manifest["product"]

        products.append(
            {
                "id": product["id"],
                "name": product["name"],
                "version": product["version"],
                "status": product.get("status", "unknown"),
            }
        )

    output(
        {
            "success": True,
            "count": len(products),
            "products": products,
        }
    )


def command_show(product_id: str) -> None:
    output(load_product(product_id))


def command_plan(product_id: str, action: str = "install") -> None:
    manifest = load_product(product_id)

    output(
        {
            "success": True,
            "mode": "plan",
            "action": action,
            "safeMode": True,
            "changesApplied": False,
            "product": manifest["product"],
            "target": detect_platform()["platform"],
            "steps": product_steps(manifest, action),
        }
    )


def command_run(product_id: str, action: str) -> None:
    manifest = load_product(product_id)
    detected = detect_platform()["platform"]

    supported_adapters = manifest["requirements"].get(
        "platformAdapters",
        [],
    )

    if detected["adapter"] not in supported_adapters:
        output(
            {
                "success": False,
                "error": "Unsupported platform adapter",
                "adapter": detected["adapter"],
                "supportedAdapters": supported_adapters,
            },
            1,
        )

    preflight = validate_lifecycle_plan(
        manifest=manifest,
        action=action,
        adapter_id=detected["adapter"],
    )

    if not preflight["compatible"]:
        output(
            {
                "success": False,
                "safeMode": True,
                "changesApplied": False,
                "blocked": True,
                "error": "Lifecycle plan failed capability validation.",
                "validation": preflight,
            },
            1,
        )

    store = StateStore(ROOT)
    registry = build_default_registry()
    executor = LifecycleExecutor(store, registry)

    operation = store.create_operation(
        product=manifest["product"],
        action=action,
        adapter=detected["adapter"],
        steps=product_steps(manifest, action),
        dry_run=True,
    )

    result = executor.execute_dry_run(
        operation,
        manifest=manifest,
    )

    output(
        {
            "success": True,
            "safeMode": True,
            "changesApplied": False,
            "operation": result,
        }
    )


def command_operations() -> None:
    store = StateStore(ROOT)
    operations = store.list_operations()

    output(
        {
            "success": True,
            "count": len(operations),
            "operations": operations,
        }
    )


def command_operation_show(operation_id: str) -> None:
    store = StateStore(ROOT)

    try:
        operation = store.load_operation(operation_id)
    except FileNotFoundError as exc:
        output(
            {
                "success": False,
                "error": str(exc),
            },
            1,
        )

    output(operation)


def command_operation_evidence(operation_id: str) -> None:
    store = StateStore(ROOT)

    output(
        {
            "success": True,
            "operationId": operation_id,
            "events": store.read_evidence(operation_id),
        }
    )


def command_operation_resume(operation_id: str) -> None:
    store = StateStore(ROOT)
    registry = build_default_registry()
    executor = LifecycleExecutor(store, registry)

    try:
        operation = store.load_operation(operation_id)
    except FileNotFoundError as exc:
        output(
            {
                "success": False,
                "error": str(exc),
            },
            1,
        )

    manifest = load_product(operation['product']['id'])
    result = executor.resume_dry_run(
        operation,
        manifest=manifest,
    )

    output(
        {
            "success": True,
            "safeMode": True,
            "changesApplied": False,
            "operation": result,
        }
    )



def command_adapters() -> None:
    adapters = list_adapters()
    output({"success": True, "count": len(adapters), "adapters": adapters})


def command_adapter_show(adapter_id: str) -> None:
    try:
        adapter = require_adapter(adapter_id)
    except KeyError as exc:
        output({"success": False, "error": str(exc)}, 1)
    output(adapter.to_dict())


def command_capabilities() -> None:
    output({"success": True, "count": len(ALL_CAPABILITIES), "capabilities": list(ALL_CAPABILITIES)})


def command_validate(product_id: str) -> None:
    manifest = load_product(product_id)
    adapter_id = detect_platform()["platform"]["adapter"]
    validation = validate_product(manifest, adapter_id)
    output({
        "success": validation["compatible"],
        "safeMode": True,
        "changesApplied": False,
        "validation": validation,
    }, 0 if validation["compatible"] else 1)




def command_plan_check(
    product_id: str,
    action: str = "install",
) -> None:
    manifest = load_product(product_id)
    adapter_id = detect_platform()["platform"]["adapter"]

    validation = validate_lifecycle_plan(
        manifest=manifest,
        action=action,
        adapter_id=adapter_id,
    )

    output(
        {
            "success": validation["compatible"],
            "safeMode": True,
            "changesApplied": False,
            "validation": validation,
        },
        0 if validation["compatible"] else 1,
    )



def command_operation_summary(operation_id: str) -> None:
    store = StateStore(ROOT)
    try:
        operation = store.load_operation(operation_id)
    except FileNotFoundError as exc:
        output({"success": False, "error": str(exc)}, 1)
    output(summarize_operation(operation))


def command_operation_latest(
    product_id: str | None = None,
) -> None:
    store = StateStore(ROOT)
    operations = store.list_operations()

    if product_id is not None:
        operations = [
            operation
            for operation in operations
            if operation.get("product", {}).get("id") == product_id
        ]

    if not operations:
        output({
            "success": False,
            "error": "No matching operations found.",
        }, 1)

    output(summarize_operation(operations[0]))


def command_operation_timeline(operation_id: str) -> None:
    store = StateStore(ROOT)
    events = store.read_evidence(operation_id)
    output({
        "success": True,
        "operationId": operation_id,
        "count": len(events),
        "events": events,
    })


def command_doctor() -> None:
    detected = detect_platform()["platform"]

    checks = [
        {
            "name": "python3",
            "healthy": sys.version_info >= (3, 10),
        },
        {
            "name": "products-directory",
            "healthy": PRODUCTS.is_dir(),
        },
        {
            "name": "state-directory",
            "healthy": STATE.is_dir(),
        },
        {
            "name": "state-writable",
            "healthy": STATE.is_dir() and os.access(STATE, os.W_OK),
        },
        {
            "name": "platform-supported",
            "healthy": detected["supported"],
            "value": detected["adapter"],
        },
    ]

    healthy = all(check["healthy"] for check in checks)

    output(
        {
            "product": "Seymour Platform Installer",
            "ready": healthy,
            "safeMode": True,
            "platform": detected,
            "checks": checks,
        },
        0 if healthy else 1,
    )


def show_help() -> None:
    print(
        """Seymour Platform Installer

System:
  spi version
  spi platform
  spi doctor

Adapters:
  spi adapters
  spi adapter show <adapter-id>
  spi capabilities

Products:
  spi products
  spi product show <product-id>
  spi plan <product-id> [install|repair|upgrade]
  spi validate <product-id>
  spi plan-check <product-id> [install|repair|upgrade]

Dry-run lifecycle:
  spi run <product-id> [install|repair|upgrade]

Operations:
  spi operations
  spi operation show <operation-id>
  spi operation evidence <operation-id>
  spi operation resume <operation-id>
  spi operation summary <operation-id>
  spi operation latest [product-id]
  spi operation timeline <operation-id>

Package 002 is dry-run only.
No live host, service, container, package, or storage changes are enabled.
"""
    )


def main() -> None:
    args = sys.argv[1:]
    command = args[0] if args else "help"

    if command == "version":
        command_version()

    elif command == "platform":
        command_platform()

    elif command == "adapters":
        command_adapters()

    elif command == "adapter" and len(args) >= 3 and args[1] == "show":
        command_adapter_show(args[2])

    elif command == "capabilities":
        command_capabilities()

    elif command == "products":
        command_products()

    elif command == "product" and len(args) >= 3 and args[1] == "show":
        command_show(args[2])

    elif command == "validate" and len(args) >= 2:
        command_validate(args[1])

    elif command == "plan-check" and len(args) >= 2:
        command_plan_check(
            args[1],
            args[2] if len(args) >= 3 else "install",
        )

    elif command == "plan" and len(args) >= 2:
        command_plan(
            args[1],
            args[2] if len(args) >= 3 else "install",
        )

    elif command == "run" and len(args) >= 2:
        command_run(
            args[1],
            args[2] if len(args) >= 3 else "install",
        )

    elif command == "operations":
        command_operations()

    elif command == "operation" and len(args) >= 2 and args[1] == "latest":
        command_operation_latest(
            args[2] if len(args) >= 3 else None
        )

    elif command == "operation" and len(args) >= 3:
        action = args[1]
        operation_id = args[2]

        if action == "show":
            command_operation_show(operation_id)
        elif action == "evidence":
            command_operation_evidence(operation_id)
        elif action == "resume":
            command_operation_resume(operation_id)
        elif action == "summary":
            command_operation_summary(operation_id)
        elif action == "timeline":
            command_operation_timeline(operation_id)
        else:
            output(
                {
                    "success": False,
                    "error": f"Unknown operation action: {action}",
                },
                1,
            )

    elif command == "doctor":
        command_doctor()

    elif command in {"help", "--help", "-h"}:
        show_help()

    else:
        output(
            {
                "success": False,
                "error": "Unknown or incomplete command.",
            },
            1,
        )


if __name__ == "__main__":
    main()
